<mxfile host="app.diagrams.net" modified="2026-10-08T12:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="D1_Data_Model_ERD" name="D1 Entity-Relationship Diagram">
    <mxGraphModel dx="1422" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BLOCK -->
        <mxCell id="title_box" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;StreetSmart — Detailed Data Model (Design D1)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Entity-Relationship Diagram: Decoupled Video Runs, Potholes, Point Detections, and Evidence Images&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1270" height="60" as="geometry" />
        </mxCell>

        <!-- LEGEND CONTAINER -->
        <mxCell id="legend_box" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;ERD Conventions &amp;amp; Legend&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 4px; font-size: 11px;&quot;&gt;&lt;b style=&quot;color: #1864ab;&quot;&gt;PK&lt;/b&gt;: Primary Key (UUIDv4 unique ID)&lt;br&gt;&lt;b style=&quot;color: #d9480f;&quot;&gt;FK&lt;/b&gt;: Foreign Key (Referential link)&lt;br&gt;&lt;b style=&quot;color: #2b8a3e;&quot;&gt;GIST&lt;/b&gt;: PostGIS Spatial R-Tree Index&lt;br&gt;&lt;b style=&quot;color: #495057;&quot;&gt;BTREE&lt;/b&gt;: Standard B-Tree Index&lt;br&gt;&lt;b style=&quot;color: #1971c2;&quot;&gt;1 : N&lt;/b&gt;: One-to-Many Relationship&lt;br&gt;&lt;b&gt;CRS&lt;/b&gt;: WGS84 Geodetic (EPSG:4326)&lt;br&gt;&lt;font color=&quot;#868e96&quot;&gt;Images decoupled to Supabase Storage&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#adb5bd;strokeWidth=2;fontColor=#212529;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="100" width="290" height="210" as="geometry" />
        </mxCell>

        <!-- ENTITY 1: VIDEO_RUN -->
        <mxCell id="ent_video_run" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;VIDEO_RUN&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 6px; font-size: 12px;&quot;&gt;&lt;b style=&quot;color: #1864ab;&quot;&gt;+ id:&lt;/b&gt; uuid &lt;b&gt;[PK]&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ source_video_name:&lt;/b&gt; text&lt;br&gt;&lt;b&gt;+ started_at:&lt;/b&gt; timestamptz&lt;br&gt;&lt;b&gt;+ completed_at:&lt;/b&gt; timestamptz&lt;br&gt;&lt;b&gt;+ processing_status:&lt;/b&gt; text&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#1971c2;strokeWidth=2;fontColor=#1864ab;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- ENTITY 2: POTHOLE -->
        <mxCell id="ent_pothole" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;POTHOLE&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;Canonical Roadway Hazard&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 6px; font-size: 12px;&quot;&gt;&lt;b style=&quot;color: #2b8a3e;&quot;&gt;+ id:&lt;/b&gt; uuid &lt;b&gt;[PK]&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color: #2b8a3e;&quot;&gt;+ location:&lt;/b&gt; geometry(Point, 4326) &lt;b&gt;[GIST]&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ aggregated_confidence:&lt;/b&gt; float &lt;b&gt;[BTREE]&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ observation_count:&lt;/b&gt; integer&lt;br&gt;&lt;b&gt;+ status:&lt;/b&gt; text &lt;b&gt;[BTREE]&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ first_detected_at:&lt;/b&gt; timestamptz&lt;br&gt;&lt;b&gt;+ last_detected_at:&lt;/b&gt; timestamptz&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#2b8a3e;strokeWidth=2;fontColor=#2b8a3e;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="310" height="240" as="geometry" />
        </mxCell>

        <!-- ENTITY 3: DETECTION -->
        <mxCell id="ent_detection" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;DETECTION&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;Point Frame Observation&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 6px; font-size: 12px;&quot;&gt;&lt;b style=&quot;color: #d9480f;&quot;&gt;+ id:&lt;/b&gt; uuid &lt;b&gt;[PK]&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #1864ab;&quot;&gt;+ video_run_id:&lt;/i&gt; uuid &lt;b&gt;[FK, BTREE]&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #2b8a3e;&quot;&gt;+ pothole_id:&lt;/i&gt; uuid &lt;b&gt;[FK, BTREE]&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ model_confidence:&lt;/b&gt; float&lt;br&gt;&lt;b&gt;+ detected_at:&lt;/b&gt; timestamptz&lt;br&gt;&lt;b&gt;+ frame_index:&lt;/b&gt; integer&lt;br&gt;&lt;b&gt;+ observed_location:&lt;/b&gt; geometry(Point, 4326)&lt;br&gt;&lt;font color=&quot;#868e96&quot; style=&quot;font-size: 10px;&quot;&gt;Unique Index: (video_run_id, frame_index)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d9480f;strokeWidth=2;fontColor=#d9480f;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="240" width="330" height="250" as="geometry" />
        </mxCell>

        <!-- ENTITY 4: EVIDENCE_IMAGE -->
        <mxCell id="ent_evidence_image" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;EVIDENCE_IMAGE&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;padding: 6px; font-size: 12px;&quot;&gt;&lt;b style=&quot;color: #6741d9;&quot;&gt;+ id:&lt;/b&gt; uuid &lt;b&gt;[PK]&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color: #d9480f;&quot;&gt;+ detection_id:&lt;/i&gt; uuid &lt;b&gt;[FK, BTREE]&lt;/b&gt;&lt;br&gt;&lt;b&gt;+ storage_path:&lt;/b&gt; text&lt;br&gt;&lt;b&gt;+ created_at:&lt;/b&gt; timestamptz&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#6741d9;strokeWidth=2;fontColor=#6741d9;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="980" y="400" width="290" height="170" as="geometry" />
        </mxCell>

        <!-- CONNECTIONS / RELATIONSHIPS -->
        <!-- VIDEO_RUN (1) -> (0..N) DETECTION -->
        <mxCell id="edge_run_det" value="&lt;b&gt;produces (1 : N)&lt;/b&gt;&lt;br&gt;1 Run → 0..* Detections" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1971c2;strokeWidth=2;fontColor=#1864ab;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="ent_video_run" target="ent_detection" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- POTHOLE (1) -> (0..N) DETECTION -->
        <mxCell id="edge_pothole_det" value="&lt;b&gt;groups (1 : N)&lt;/b&gt;&lt;br&gt;1 Pothole → 1..* Detections" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2b8a3e;strokeWidth=2;fontColor=#2b8a3e;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="ent_pothole" target="ent_detection" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DETECTION (1) -> (0..N) EVIDENCE_IMAGE -->
        <mxCell id="edge_det_img" value="&lt;b&gt;has (1 : N)&lt;/b&gt;&lt;br&gt;1 Detection → 0..* Images" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6741d9;strokeWidth=2;fontColor=#6741d9;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ent_detection" target="ent_evidence_image" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>