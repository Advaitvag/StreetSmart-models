# Model weights and training checkpoints via Git LFS.
*.pt   filter=lfs diff=lfs merge=lfs -text
*.pth  filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text

# Training plots / sample batches (kept under runs/ and models/).
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.JPG  filter=lfs diff=lfs merge=lfs -text

# TensorBoard event files.
events.out.tfevents.* filter=lfs diff=lfs merge=lfs -text

# Docs: normalize line endings so Windows and Linux edits don't show as whole-file diffs.
*.md      text eol=lf
*.drawio  text eol=lf
*.base    text eol=lf
*.canvas  text eol=lf
StreetSmart_docs/.obsidian/*.json text eol=lf
